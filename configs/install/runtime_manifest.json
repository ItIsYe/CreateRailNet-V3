{
  "version": 1,
  "purpose": "Runtime-only file manifest for ingame CC:Tweaked installation.",
  "include": [
    "scripts/setup.lua",
    "scripts/setup_main.lua",
    "startup.lua",
    "scripts/start_master.lua",
    "scripts/start_train.lua",
    "scripts/start_panel.lua",
    "scripts/start_signal.lua",
    "scripts/start_sensor.lua",
    "scripts/start_switch.lua",
    "scripts/start_station.lua",
    "scripts/start_depot.lua",
    "scripts/start_arbiter.lua",
    "scripts/start_fleet.lua",
    "scripts/ota_push.lua",
    "scripts/upgrade_startup.lua",
    "scripts/keys.lua",
    "scripts/keys_main.lua",
    "scripts/auth_bench.lua",
    "scripts/auth_bench_main.lua",
    "scripts/bind_signals.lua",
    "scripts/bind_monitors.lua",
    "src/setup/**",
    "src/shared/**",
    "src/domain/**",
    "src/fleet/**",
    "src/panel/**",
    "src/adapter/**",
    "src/master/**",
    "src/nodes/**",
    "configs/templates/network.example.json",
    "configs/templates/network.redstone.example.json",
    "configs/templates/network.create.example.json",
    "configs/templates/network.mixed.example.json",
    "configs/templates/network.full.example.json",
    "configs/templates/network.service_plan.example.json"
  ],
  "exclude": [
    "src/sim/**",
    "tests/**",
    "docs/**",
    ".github/**",
    "scripts/check_syntax.lua",
    "scripts/check_configs.lua",
    "scripts/run_tests.lua",
    "src/tools/**",
    "installer",
    "install/**",
    "scripts/manifest_sync.lua"
  ],
  "notes": [
    "src/sim is offline-only and must never be installed on ingame computers.",
    "tests and GitHub workflow files are offline-only.",
    "src/tools contains development and diagnostic tools; install manually only when explicitly needed.",
    "The installer (installer, install/**) is fetched from GitHub by the computer itself and is not installed; install/manifest.lua is generated from this file's include/exclude rules by scripts/manifest_sync.lua."
  ]
}
