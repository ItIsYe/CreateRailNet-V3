--[[
Purpose: One-line installer for a CreateRailNet computer. Downloads its own modules and the files of one ref from GitHub, replaces only
  what differs, then starts the setup wizard (new computer) or restarts (update).
Usage on a CC:Tweaked computer with http enabled:
  wget run https://raw.githubusercontent.com/ItIsYe/CreateRailNet-V3/<ref>/installer
  or: wget https://raw.githubusercontent.com/ItIsYe/CreateRailNet-V3/<ref>/installer installer   and then   installer
Options: --ref <branch|tag>   source (default: main)
         --role <role>        master signal sensor switch station depot train panel (default: the installed role, or a menu)
         --yes                no questions (keeps the installed role)
         --resume             finish an interrupted installation (startup.lua calls this by itself)
         --setup / --slim     only fetch / remove the setup files (wizard, doctor, key tool ...); scripts/setup.lua does that by itself
         --preview            only say what would be installed (new / changed / removed files, space); changes nothing
Notes: thin bootstrap, like the installer of the reactor project: the real logic lives in install/*.lua of the same ref and is
  downloaded on every run, so there is no second copy to keep in sync. Nothing on the computer is changed before the space check
  passed. docs/INSTALL.md has the details.
]]

local REPO_RAW = "https://raw.githubusercontent.com/ItIsYe/CreateRailNet-V3/"
local DEFAULT_REF = "main"

local function say(text) pcall(print, tostring(text)) end

if not http then error("HTTP ist nicht verfuegbar: in der ComputerCraft-Konfiguration 'http' aktivieren.", 0) end

-- ── arguments ────────────────────────────────────────────────────────────────
local args = {}
do
  local argv = { ... }
  local i = 1
  while i <= #argv do
    local token = argv[i]
    if token == "--yes" then args.yes = true; i = i + 1
    elseif token == "--resume" then args.resume = true; i = i + 1
    elseif token == "--preview" then args.preview = true; i = i + 1
    elseif token == "--setup" then args.setup = true; i = i + 1
    elseif token == "--slim" then args.slim = true; i = i + 1
    elseif token == "--role" or token == "--ref" then
      if not argv[i + 1] then error("Zu " .. token .. " fehlt der Wert.", 0) end
      args[token:sub(3)] = argv[i + 1]
      i = i + 2
    else
      error("Unbekannte Option: " .. tostring(token) .. " (erlaubt: --ref --role --yes --resume --preview --setup --slim)", 0)
    end
  end
end
if (args.setup and args.slim) or ((args.setup or args.slim) and (args.preview or args.resume)) then error("--setup und --slim gehen weder zusammen noch mit --preview oder --resume.", 0) end
if args.preview and args.resume then error("--preview und --resume gehen nicht zusammen: eine Vorschau aendert nichts, --resume setzt eine Installation fort.", 0) end
local ref = args.ref or DEFAULT_REF
-- before any URL is built: branch names and tags, nothing that could leave the repository path
if #ref > 100 or not ref:match("^[%w%._%-/]+$") or ref:find("..", 1, true) or ref:sub(1, 1) == "/" or ref:sub(-1) == "/" then
  error("Ungueltiger Ref: " .. tostring(ref), 0)
end

-- ── the first module comes through a plain download (the http module is not there yet) ─────────────────────────────
local ENV = (getfenv and getfenv(1)) or _ENV
local function compile(source, name)
  if setfenv then
    local fn, err = (loadstring or load)(source, "=" .. name)
    if fn then setfenv(fn, ENV) end
    return fn, err
  end
  return load(source, "=" .. name, "t", ENV)
end

local function plain_download(url)
  local last
  for attempt = 1, 4 do
    local ok, response = pcall(http.get, url .. "?crn_cb=" .. attempt .. "_" .. tostring(os.epoch and os.epoch("utc") or os.time()))
    if ok and response then
      local ok_read, body = pcall(response.readAll)
      pcall(response.close)
      if ok_read and type(body) == "string" and #body > 0 and not body:sub(1, 200):lower():find("<html", 1, true) then return body end
      last = "unbrauchbare Antwort"
    else
      last = type(response) == "string" and response or "http.get fehlgeschlagen"
    end
    if attempt < 4 then say("  Download-Versuch " .. attempt .. " fehlgeschlagen (" .. tostring(last) .. "), erneut in " .. attempt * 2 .. " s ..."); os.sleep(attempt * 2) end
  end
  return nil, last
end

local function load_module(name, source)
  local fn, err = compile(source, name)
  if not fn then error("Modul " .. name .. ": Syntaxfehler: " .. tostring(err), 0) end
  local ok, module = pcall(fn)
  if not ok then error("Modul " .. name .. ": Ladefehler: " .. tostring(module), 0) end
  return module
end

local function yield()
  if os.queueEvent and os.pullEvent then
    os.queueEvent("crn_install_yield")
    os.pullEvent("crn_install_yield")
  end
end

say("CreateRailNet Installer, Ref: " .. ref)

local http_source, http_err = plain_download(REPO_RAW .. ref .. "/install/http.lua")
if not http_source then error("install/http.lua konnte nicht geladen werden (Ref '" .. ref .. "' vorhanden?): " .. tostring(http_err), 0) end
local http_module = load_module("install/http", http_source)
local client = http_module.new({ base = REPO_RAW, http = http, parallel = parallel, sleep = os.sleep })

-- ── everything else comes from the same ref ────────────────────────────────────────────────────────────────────────
local MODULES = {
  plan = "install/plan.lua", stage = "install/stage.lua", ui = "install/ui.lua", journal = "install/journal.lua",
  init = "install/init.lua",
  checksum = "src/shared/checksum.lua", safe_write = "src/shared/safe_write.lua", startup_template = "src/shared/startup_template.lua",
}
local loaded = {}
for key, path in pairs(MODULES) do
  local source, err = client.download_file(ref, path)
  if not source then error(tostring(err), 0) end
  loaded[key] = load_module(path, source)
end

local runtime = { fs = fs, shell = shell, sleep = os.sleep, reboot = os.reboot, yield = yield }
local ui = loaded.ui.new({ print = print, write = write or io.write, read = read, term = term, colors = colors })
local stage = loaded.stage.new({
  fs = fs, safe_write = loaded.safe_write, checksum = loaded.checksum, http = client, compile = compile, sleep = os.sleep, yield = yield,
})
local journal = loaded.journal.new({ fs = fs, safe_write = loaded.safe_write })

local ok, result = pcall(loaded.init, {
  ref = ref, args = args, http = client, plan = loaded.plan, stage = stage, ui = ui, journal = journal,
  checksum = loaded.checksum, safe_write = loaded.safe_write, startup_template = loaded.startup_template, env = runtime,
})
if not ok then
  pcall(ui.progress_done)
  say("")
  say("[ERR ] " .. tostring(result))
  error("Installation nicht abgeschlossen.", 0)
end

if result.preview then
  say("")
  say("Vorschau beendet.")
elseif result.bundle then
  say("")
  say(result.bundle == "setup" and "Einrichtungs-Dateien geladen." or "Einrichtungs-Dateien entfernt.")
elseif result.needs_setup then
  if args.yes or args.resume then
    say("Dieser Computer ist noch nicht eingerichtet: 'scripts/setup.lua' ausfuehren (Rolle " .. result.role .. ").")
  elseif shell then
    say("")
    say("Weiter mit dem Einrichtungs-Assistenten ...")
    shell.run("scripts/setup.lua", "--role", result.role)
  else
    say("Weiter mit: scripts/setup.lua --role " .. result.role)
  end
else
  say("Neustart in 2 Sekunden ...")
  os.sleep(2)
  os.reboot()
end
